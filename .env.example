# Copy to .env and adjust. Never commit real secrets.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://accessgraph:accessgraph@localhost:5432/accessgraph
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me
# Fernet key used to encrypt provider tokens at rest (Phase 5). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# GitHub App (Phase 2). Create under your org Settings > Developer settings.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM private key; escape newlines as \n when setting via environment.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE=https://api.github.com
GITHUB_WEB_BASE=https://github.com
